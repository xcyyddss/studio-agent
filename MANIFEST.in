include README.md
include LICENSE
include CONTRIBUTING.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
include 启动Studio.ps1
include .gitignore
include .gitattributes
recursive-include docs *.md
recursive-include tests *.py *.md *.cjs
recursive-include studio_runtime/static *.html *.css *.js
recursive-include studio_runtime/protocols *.json
recursive-include studio_runtime/tokenizer_data *
prune .git
prune .validation
prune studio-data
prune snapshots
prune build
prune dist
prune .venv
prune node_modules
global-exclude __pycache__ *.py[cod] .DS_Store
